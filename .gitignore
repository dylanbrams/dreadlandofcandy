# Credentials: never commit
AccessKeys/
*.pem
.env

# Unreal generated folders
Binaries/
Intermediate/
Saved/
DerivedDataCache/
Build/
Builds/
Plugins/*/Binaries/
Plugins/*/Intermediate/

# IDE and solution files
.vs/
.vscode/
.idea/
*.sln
*.slnx
*.suo
*.VC.db
*.VC.opendb
compile_commands.json

# Python
__pycache__/
*.pyc
.venv/

# OS
Thumbs.db
.DS_Store

# Claude Code session state
**/.claude/scheduled_tasks.lock
**/.claude/settings.local.json

# Tripo outputs: only the manifests are tracked
ImportSource/*/*.glb

# Asset generation runner scratch (state.json and review.html are kept)
ImportSource/_gen/logs/
ImportSource/_gen/run.lock
ImportSource/_gen/state.json.part
Assets/Incoming/2D/_drop/
*.part

# BACKEND service is its own nested repo
backend/

# Blender backups and FBX SDK texture extraction folders (regenerated on import)
*.blend1
*.fbm/
